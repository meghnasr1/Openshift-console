# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Kubernetes Configuration
# Leave KUBECONFIG empty to use default ~/.kube/config
# Or set to in-cluster to use service account (for production)
KUBECONFIG=

# Authentication (MVP - API Key)
# Generate with: openssl rand -hex 32
API_KEY=your-api-key-here

# Session Configuration (for future SSO integration)
SESSION_SECRET=

# OIDC Configuration (for future SSO integration)
# OIDC_ISSUER_URL=https://keycloak.example.com/auth/realms/myrealm
# OIDC_CLIENT_ID=readonly-console
# OIDC_CLIENT_SECRET=<secret>
# OIDC_REDIRECT_URI=http://localhost:4000/auth/callback

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
